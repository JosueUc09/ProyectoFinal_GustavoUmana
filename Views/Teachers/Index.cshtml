@model IEnumerable<ProyectoFinal.Models.Teacher>
@{
    Layout = "_Layout";
}

<h2>Profesores</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Nuevo Profesor</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Name</td>
            <td>@t.Email</td>
            <td>
                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@t.Id">Editar</a>
                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@t.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
