@model ProyectoFinal.Models.Course
@{
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Nuevo Curso</h4>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Carrera</label>
                        <select asp-for="CareerId"
                                asp-items="ViewBag.CareerId"
                                class="form-select">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Créditos</label>
                        <input asp-for="Credits" class="form-control" />
                    </div>

                    <!-- ASIGNACIÓN DE PROFESOR -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Profesor</label>
                        <select asp-for="TeacherId"
                                asp-items="ViewBag.TeacherId"
                                class="form-select">
                            <option value="">-- Sin asignar --</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
