@model IEnumerable<ProyectoFinal.Models.Course>
@Html.AntiForgeryToken()

@{
    Layout = "_Layout";
}

<div class="row">
    <div class="col-12">

        <div class="card shadow-sm border-0">

            <!-- HEADER -->
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Cursos</h4>

                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-light btn-sm" href="/Courses/Create">
                        + Nuevo Curso
                    </a>
                }
            </div>

            <!-- FILTRO -->
            <form method="get" class="row g-3 m-3">

                <div class="col-auto">
                    <label class="form-label">Créditos</label>
                    <select name="credits" class="form-select">
                        <option value="">Todos</option>
                        <option value="2" selected="@(ViewBag.Credits == 2)">2</option>
                        <option value="3" selected="@(ViewBag.Credits == 3)">3</option>
                        <option value="4" selected="@(ViewBag.Credits == 4)">4</option>
                    </select>
                </div>

                <div class="col-auto align-self-end">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a href="/Courses" class="btn btn-secondary">Limpiar</a>
                </div>

            </form>

            <!-- TABLA -->
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Curso</th>
                            <th>Carrera</th>
                            <th>Profesor</th>
                            <th>Créditos</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.Career?.Name</td>
                                <td>@(c.Teacher?.Name ?? "Sin asignar")</td>
                                <td>@c.Credits</td>
                                <td class="text-end">

                                    @if (User.IsInRole("Student"))
                                    {
                                        <button class="btn btn-success btn-sm me-1"
                                                onclick="enroll(@c.Id)">
                                            Matricular
                                        </button>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a class="btn btn-warning btn-sm"
                                           href="/Courses/Edit/@c.Id">
                                            Editar
                                        </a>
                                        <a class="btn btn-danger btn-sm"
                                           href="/Courses/Delete/@c.Id">
                                            Eliminar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINACIÓN (RESPETA FILTRO) -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">

                            <li class="page-item @(ViewBag.Page <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="/Courses?page=@(ViewBag.Page - 1)&credits=@ViewBag.Credits">
                                    Anterior
                                </a>
                            </li>

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                                    <a class="page-link"
                                       href="/Courses?page=@i&credits=@ViewBag.Credits">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(ViewBag.Page >= ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="/Courses?page=@(ViewBag.Page + 1)&credits=@ViewBag.Credits">
                                    Siguiente
                                </a>
                            </li>

                        </ul>
                    </nav>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
<script>
    function enroll(courseId) {

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('/Enrollments/EnrollAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `courseId=${courseId}`
        })
        .then(res => res.json())
        .then(data => {
            alert(data.message);
        })
        .catch(err => {
            alert("Error al procesar la matrícula");
            console.error(err);
        });
    }
</script>
}

