@model IEnumerable<ProyectoFinal.Models.Enrollment>
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Matrículas</h2>

    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" href="/Enrollments/Create">
            Nueva Matrícula
        </a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Listado de Matrículas</h5>
    </div>

    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>Curso</th>
                    <th>Estudiante</th>
                    <th>Correo</th>
                    <th>Fecha</th>
                    <th style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            No hay matrículas registradas
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Course?.Name</td>
                            <td>@e.StudentName</td>
                            <td>@e.StudentEmail</td>
                            <td>@e.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a class="btn btn-warning btn-sm"
                                   href="/Enrollments/Edit/@e.Id">
                                    Editar
                                </a>
                                <a class="btn btn-danger btn-sm"
                                   href="/Enrollments/Delete/@e.Id">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
