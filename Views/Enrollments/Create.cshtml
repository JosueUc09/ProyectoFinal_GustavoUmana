@model ProyectoFinal.Models.Enrollment
@{
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Nueva Matrícula</h5>
            </div>

            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Curso</label>
                        <select asp-for="CourseId"
                                asp-items="ViewBag.CourseId"
                                class="form-select">
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre del estudiante</label>
                        <input asp-for="StudentName" class="form-control" />
                        <span asp-validation-for="StudentName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo del estudiante</label>
                        <input asp-for="StudentEmail" class="form-control" />
                        <span asp-validation-for="StudentEmail" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="/Enrollments" class="btn btn-outline-secondary me-2">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Guardar Matrícula
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
