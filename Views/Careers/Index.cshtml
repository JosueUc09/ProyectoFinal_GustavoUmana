@model IEnumerable<ProyectoFinal.Models.Career>
@Html.AntiForgeryToken()

@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h3 class="mb-0">Carreras</h3>

    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" href="/Careers/Create">
            Nueva Carrera
        </a>
    }
</div>

<div class="card shadow border-0">
    <div class="card-header bg-primary text-white">
        <strong>Listado de Carreras</strong>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            No hay carreras registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.Description</td>
                            <td class="text-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="btn btn-outline-warning btn-sm" href="/Careers/Edit/@c.Id">
                                        Editar
                                    </a>
                                    <a class="btn btn-outline-danger btn-sm" href="/Careers/Delete/@c.Id">
                                        Eliminar
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
